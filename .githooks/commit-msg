#!/usr/bin/env bash
# Enforces Conventional Commits on the subject line (see CONTRIBUTING.md).
set -euo pipefail

subject="$(head -n1 "$1")"
pattern='^(feat|fix|refactor|perf|chore|docs|ci|build|revert)(\([a-z0-9-]+\))?!?: [^ ].*[^.]$'

# Let git's own generated messages through.
if [[ "$subject" =~ ^(Merge|Revert\ \"|fixup!|squash!) ]] || [[ "$subject" =~ $pattern ]]; then
  exit 0
fi

echo "commit-msg: subject must follow Conventional Commits, e.g. 'feat(ddns): migrate stack from k3s'" >&2
echo "            got: $subject" >&2
echo "            see CONTRIBUTING.md" >&2
exit 1
